{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CALLIE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Development (Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "QT_QML_GENERATE_QMLLS_INI": "ON",
        "CALLIE_LIVE_QML": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "ci",
      "inherits": "base",
      "displayName": "CI (warnings are errors)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CALLIE_WERROR": "ON",
        "CALLIE_LIVE_QML": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "ci-qmllint", "configurePreset": "ci", "targets": ["all_qmllint"] }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": { "outputOnFailure": true, "verbosity": "verbose" },
      "execution": { "noTestsAction": "error" }
    }
  ],
  "workflowPresets": [
    {
      "name": "ci",
      "displayName": "Configure, build, lint and test as CI does",
      "steps": [
        { "type": "configure", "name": "ci" },
        { "type": "build", "name": "ci" },
        { "type": "build", "name": "ci-qmllint" },
        { "type": "test", "name": "ci" }
      ]
    }
  ]
}
